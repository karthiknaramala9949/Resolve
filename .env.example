# RESOLVE-ONE Production & Development Environment Configuration
# Target Stack: Vercel (Frontend) + Convex (Backend & DB) + IndexedDB (Offline) + Client-Side E2EE

# ==========================================
# CONVEX BACKEND CONFIGURATION
# https://dashboard.convex.dev/t/naramala-venkata-karthik
# ==========================================
# Development deployment identifier (set by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:generous-falcon-999

# Public Convex Cloud URL for client queries, mutations, and WebSocket sync
NEXT_PUBLIC_CONVEX_URL=https://generous-falcon-999.convex.cloud

# Convex HTTP Actions / Better Auth HTTP router site domain
# Typically: https://<deployment-name>.convex.site
CONVEX_SITE_URL=https://generous-falcon-999.convex.site

# Production Convex Deploy Key (Used in CI/CD / Vercel build settings)
# Obtain from Convex Dashboard -> Project Settings -> Deploy Keys
# CONVEX_DEPLOY_KEY=prod:...

# ==========================================
# APPLICATION & BETTER AUTH CONFIGURATION
# ==========================================
# Application Base URL (Used for OAuth redirects, verification links, and cookie domains)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Better Auth Secret (Minimum 32 characters, high entropy)
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=resolve_dev_secret_replace_in_production_32chars_min_length_value

# Transitional Legacy Auth Secret (Fallback during phased migration)
AUTH_SECRET=resolve_dev_secret_replace_in_production_32chars_min_length_value

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs:
#   Development: http://localhost:3000/api/auth/callback/google
#   Production:  https://<your-domain>/api/auth/callback/google
#   Convex Site: https://<deployment-name>.convex.site/api/auth/callback/google
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# SMS / OTP GATEWAY (OPTIONAL)
# Defaults to secure in-app debug OTP delivery in development mode
# ==========================================
# SMS_GATEWAY_API_KEY=
