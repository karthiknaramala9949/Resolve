# RESOLVE-ONE Authentication Environment Configuration

# Application Base URL (Used for OAuth redirects and email verification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ byte cryptographic secret for signing sessions and tokens
# Generate one with: openssl rand -base64 32
AUTH_SECRET=resolve_dev_secret_replace_in_production_32chars_min_length_value

# Google OAuth Credentials (https://console.cloud.google.com/apis/credentials)
# Set Authorized redirect URI to: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMS / OTP Gateway configuration (defaults to in-memory console delivery in development)
# SMS_GATEWAY_API_KEY=

