# RESOLVE-ONE Production & Development Environment Configuration
# Target Stack: Next.js on Vercel (Frontend) + Convex (Authoritative Backend & DB) + Client-Side E2EE

# ==========================================
# CONVEX BACKEND CONFIGURATION
# ==========================================
# Development deployment identifier (set by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:resolve-dev-sandbox

# Public Convex Cloud URL for client queries, mutations, and WebSocket sync
NEXT_PUBLIC_CONVEX_URL=https://generous-falcon-999.convex.cloud

# Convex HTTP Actions / Better Auth HTTP router site domain
# Typically: https://<deployment-name>.convex.site
CONVEX_SITE_URL=https://generous-falcon-999.convex.site

# Production Convex Deploy Key (Used strictly in CI/CD / Vercel build settings)
# Obtain from Convex Dashboard -> Project Settings -> Deploy Keys
# CONVEX_DEPLOY_KEY=prod:...

# ==========================================
# PRODUCT POLICY & FEATURE FLAGS
# ==========================================
# Enable or disable anonymous guest onboarding (default: true)
NEXT_PUBLIC_ENABLE_GUEST_ACCESS=true

# ==========================================
# APPLICATION & BETTER AUTH CONFIGURATION
# ==========================================
# Application Base URL (Used for OAuth redirects, verification links, and cookie domains)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Better Auth Secret (Minimum 32 characters, high entropy)
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=resolve_dev_secret_replace_in_production_32chars_min_length_value

# ==========================================
# GOOGLE OAUTH CONFIGURATION
# (https://console.cloud.google.com/apis/credentials)
#
# In Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client:
#
# Authorized JavaScript origins:
#   Development: http://localhost:3000
#                http://localhost:3001
#                http://127.0.0.1:3000
#   Production:  https://<your-domain>
#
# Authorized redirect URIs (add both formats to guarantee compatibility):
#   Development: http://localhost:3000/api/auth/google/callback
#                http://localhost:3000/api/auth/callback/google
#                http://localhost:3001/api/auth/google/callback
#                http://localhost:3001/api/auth/callback/google
#   Production:  https://<your-domain>/api/auth/google/callback
#                https://<your-domain>/api/auth/callback/google
#   Convex Site: https://<deployment-name>.convex.site/api/auth/callback/google
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# SMS / OTP GATEWAY (OPTIONAL)
# Defaults to secure in-app debug OTP delivery in development mode
# ==========================================
# SMS_GATEWAY_API_KEY=
